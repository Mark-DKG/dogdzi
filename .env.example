# ─────────────────────────────────────────────────────────────
# DOGDZI environment variables
# Copy to .env.local for local development. Set the same keys in
# Vercel → Project → Settings → Environment Variables.
# Variables prefixed NEXT_PUBLIC_ are sent to the browser; never put
# secrets in them.
# ─────────────────────────────────────────────────────────────

# Public site URL (used for auth email redirects and metadata)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase (Project Settings → API). Without these, DOGDZI runs in
# guest-only mode: accounts, sync and the admin console are disabled.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SERVER ONLY. Used by the admin console, telemetry ingestion and the
# reminder dispatcher. Never expose this to the client.
SUPABASE_SERVICE_ROLE_KEY=

# Admin console: require a verified authenticator app (TOTP, AAL2).
# Only set to "false" for local development.
ADMIN_REQUIRE_MFA=true


# Web Push (generate with: npm run vapid:generate)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@example.com

# Protects /api/cron/reminders. Vercel Cron sends it automatically as
# "Authorization: Bearer <CRON_SECRET>".
CRON_SECRET=

# Optional: Vercel REST API access for the admin traffic panel.
# Leave empty to hide the panel.
VERCEL_API_TOKEN=
VERCEL_PROJECT_ID=
VERCEL_TEAM_ID=
